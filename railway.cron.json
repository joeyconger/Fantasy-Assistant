{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -e ."
  },
  "deploy": {
    "startCommand": "fantasy-assistant sync-draft-data && fantasy-assistant sync-market-values",
    "cronSchedule": "0 13 * * *",
    "restartPolicyType": "NEVER"
  }
}
