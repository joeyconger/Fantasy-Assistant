# Copy this file to config/secrets.yaml (gitignored) and fill in your
# ESPN cookies if sync-espn tells you the league is private.
#
# How to get these values:
#   1. Log into fantasy.espn.com in your browser.
#   2. Open DevTools (F12) -> Application tab (Chrome/Edge) or Storage tab (Firefox)
#      -> Cookies -> https://fantasy.espn.com
#   3. Find the cookie named "SWID" (looks like {ABC123-...}) and copy its value.
#   4. Find the cookie named "espn_s2" (a long alphanumeric string) and copy its value.

espn:
  swid: "{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
  espn_s2: "your-espn_s2-cookie-value-here"
