# Postgres connection (Railway provides DATABASE_URL automatically when you
# attach a Postgres plugin — for local dev, point this at a local instance).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/betting_model

# CollegeFootballData API — free tier key from https://collegefootballdata.com/key
CFBD_API_KEY=

# The Odds API — used for live/current lines going forward (Phase 4), and
# optionally to fill in recent line-movement snapshots. Historical backtest
# data (Phase 3) comes from free archives instead — see README "Odds data".
# https://the-odds-api.com
ODDS_API_KEY=

# Open-Meteo needs no API key (free, no auth) — included here only so the
# weather module has a place to put an override if that ever changes.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Required to run src/server.ts — a minimal, read-only debug dashboard
# (backtest reports, ratings, predictions) plus a raw query API, NOT the
# live-picks web app. DASHBOARD_USER/PASSWORD gate the HTML pages (Basic
# auth); ADMIN_TOKEN is a separate bearer token for POST /query
# (SELECT-only ad hoc queries). Any values — just pick real secrets.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
ADMIN_TOKEN=

NODE_ENV=development
