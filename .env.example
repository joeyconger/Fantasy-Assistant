# Environment variables for the web dashboard (used on Railway, or for local
# testing of `uvicorn fantasy_assistant.web:app`). The CLI doesn't need any of
# these except DATABASE_PATH/ESPN_SWID/ESPN_S2 if you want to override the
# local config/secrets.yaml file.

# Required to start the web dashboard at all — see README for why.
DASHBOARD_USER=changeme
DASHBOARD_PASSWORD=changeme

# Optional. On Railway, set this to a path inside your mounted Volume
# (e.g. /data/fantasy_assistant.db) so the DB survives redeploys.
# DATABASE_PATH=/data/fantasy_assistant.db

# Optional — only needed if your ESPN league is private. Takes priority over
# config/secrets.yaml (which won't exist on a deployed host anyway, since
# it's gitignored and never pushed).
# ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# ESPN_S2=your-espn_s2-cookie-value-here
